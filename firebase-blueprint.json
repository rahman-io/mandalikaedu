      "properties": {
        "id": {
          "type": "string",
          "description": "Identifier testimoni"
        },
        "name": {
          "type": "string",
          "description": "Nama awardee"
        },
        "origin": {
          "type": "string",
          "description": "Kota atau kabupaten asal"
        },
        "scholarship": {
          "type": "string",
          "description": "Nama beasiswa yang diraih"
        },
        "university": {
          "type": "string",
          "description": "Nama universitas tujuan di luar negeri"
        },
        "country": {
          "type": "string",
          "description": "Negara tujuan studi"
        },
        "flag": {
          "type": "string",
          "description": "Emoji bendera negara"
        },
        "program": {
          "type": "string",
          "description": "Program studi / jurusan yang ditempuh"
        },
        "year": {
          "type": "string",
          "description": "Tahun kelulusan atau angkatan penerima"
        },
        "initialProblem": {
          "type": "string",
          "description": "Kendala awal sebelum bimbingan"
        },
        "solutionByMandalika": {
          "type": "string",
