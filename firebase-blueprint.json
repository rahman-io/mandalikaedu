        },
        "quote": {
          "type": "string",
          "description": "Kutipan singkat testimoni"
        },
        "fullStory": {
          "type": "string",
          "description": "Kisah lengkap perjuangan meraih beasiswa"
        }
      },
      "required": ["id", "name", "scholarship", "university", "quote"]
    },
    "Country": {
      "title": "Country",
      "description": "Direktori panduan negara tujuan studi, biaya hidup, dan universitas",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Slug negara"
        },
        "name": {
          "type": "string",
          "description": "Nama negara"
        },
        "flag": {
          "type": "string",
          "description": "Emoji bendera"
        },
        "tagline": {
          "type": "string",
          "description": "Slogan keunggulan studi negara"
        },
        "capital": {
          "type": "string",
          "description": "Ibu kota negara"
        },
        "currency": {
          "type": "string",
          "description": "Mata uang resmi"
        },
        "avgLivingCostMonthly": {
          "type": "object",
          "description": "Estimasi rata-rata biaya hidup bulanan mahasiswa"
        },
        "tuitionFeeInfo": {
          "type": "string",
          "description": "Informasi biaya kuliah dan subsidi pemerintah"
        },
        "languageRequirements": {
          "type": "object",
          "description": "Syarat kemampuan bahasa Inggris dan lokal"
        },
        "popularUniversities": {
          "type": "array",
          "description": "Daftar universitas terpopuler"
        },
        "partTimeWorkRules": {
          "type": "object",
          "description": "Aturan kerja paruh waktu bagi mahasiswa internasional"
        },
        "availableScholarships": {
          "type": "array",
          "description": "Daftar beasiswa yang tersedia untuk negara ini"
        }
      },
      "required": ["id", "name", "flag"]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "Artikel edukasi, panduan esai, dan informasi beasiswa",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifier artikel"
        },
        "slug": {
          "type": "string",
          "description": "URL slug artikel"
        },
        "title": {
          "type": "string",
          "description": "Judul artikel"
        },
        "category": {
          "type": "string",
          "description": "Kategori tulisan"
        },
        "author": {
          "type": "object",
          "description": "Profil penulis artikel"
        },
        "publishedDate": {
          "type": "string",
          "description": "Tanggal publikasi artikel"
        },
        "readTime": {
          "type": "string",
          "description": "Estimasi waktu membaca"
        },
        "excerpt": {
          "type": "string",
          "description": "Ringkasan pengantar artikel"
        },
        "content": {
          "type": "array",
          "description": "Paragraf isi artikel"
        }
      },
      "required": ["id", "slug", "title", "content"]
    },
    "Booking": {
      "title": "Booking",
