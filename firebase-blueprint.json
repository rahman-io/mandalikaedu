{
  "entities": {
    "Scholarship": {
      "title": "Scholarship",
      "description": "Informasi kurasi beasiswa fully funded dan partial untuk Warga Negara Indonesia (WNI)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifier unik beasiswa (kebab-case)"
        },
        "name": {
          "type": "string",
          "description": "Nama resmi program beasiswa"
        },
        "organizer": {
          "type": "string",
          "description": "Institusi atau kementerian penyelenggara"
        },
        "country": {
          "type": "string",
          "description": "Negara tujuan studi"
        },
        "flag": {
          "type": "string",
          "description": "Emoji bendera negara tujuan"
        },
        "regionGroup": {
          "type": "string",
          "description": "Grup wilayah geografis (misal: Asia Timur, Eropa, Timur Tengah, dll.)"
        },
        "level": {
          "type": "array",
          "description": "Jenjang pendidikan yang ditanggung (S1, S2, S3, Non-Gelar)"
        },
        "fundingType": {
          "type": "string",
          "description": "Tipe pendanaan (Fully Funded atau Partial)"
        },
        "coverage": {
          "type": "array",
          "description": "Komponen pembiayaan yang dicover"
        },
        "requirements": {
          "type": "object",
          "description": "Persyaratan akademik, bahasa, usia, dan dokumen"
        },
        "applicationPeriod": {
          "type": "object",
          "description": "Jadwal pendaftaran, deadline, dan status terkini"
        },
        "deadlineDetails": {
          "type": "string",
          "description": "Rincian spesifik tanggal atau periode penutupan pendaftaran"
        },
        "fieldsOfStudy": {
          "type": "array",
          "description": "Bidang studi atau jurusan yang memenuhi syarat"
        },
        "quota": {
          "type": "string",
          "description": "Informasi kuota penerima atau jalur afirmasi"
        },
        "officialUrl": {
          "type": "string",
          "description": "Tautan portal resmi penyelenggara beasiswa"
        },
        "tipsMandalika": {
          "type": "string",
          "description": "Tips strategi lolos dari tim mentor MandalikaEdu"
        },
        "educationalNote": {
          "type": "string",
          "description": "Catatan edukatif regulasi dan eligibilitas WNI"
        },
        "statusNote": {
          "type": "string",
          "description": "Catatan status verifikasi dan pembukaan batch"
        },
        "seasonPattern": {
          "type": "string",
          "description": "Pola musim pembukaan pendaftaran kalender umum"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaharuan data dokumen ISO 8601"
        }
      },
      "required": ["id", "name", "country", "fundingType", "officialUrl"]
    },
    "Package": {
      "title": "Package",
      "description": "Paket layanan bimbingan dan mentoring beasiswa MandalikaEdu",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifier paket layanan"
        },
        "name": {
          "type": "string",
          "description": "Nama paket bimbingan"
        },
        "badge": {
          "type": "string",
          "description": "Label badge paket (misal: 100% Gratis, Populer)"
        },
        "tagline": {
          "type": "string",
          "description": "Slogan ringkas keunggulan paket"
        },
        "priceFormatted": {
          "type": "string",
          "description": "Format harga dalam Rupiah"
        },
        "priceNumber": {
          "type": "number",
          "description": "Nilai nominal harga dalam integer IDR"
        },
        "isPopular": {
          "type": "boolean",
          "description": "Penanda paket paling diminati"
        },
        "isFree": {
          "type": "boolean",
          "description": "Penanda layanan tanpa biaya"
        },
        "category": {
          "type": "string",
          "description": "Kategori paket: core, group, atau addon"
        },
        "duration": {
          "type": "string",
          "description": "Durasi atau jumlah sesi mentoring"
        },
        "features": {
          "type": "array",
          "description": "Daftar fitur dan materi mentoring"
        },
        "deliverables": {
          "type": "array",
          "description": "Luaran atau dokumen hasil bimbingan"
        },
        "targetAudience": {
          "type": "string",
          "description": "Profil peserta yang disarankan"
        },
        "whatsappMessage": {
          "type": "string",
          "description": "Pesan otomatis template pendaftaran WhatsApp"
        }
      },
      "required": ["id", "name", "priceNumber", "category"]
    },
    "Mentor": {
      "title": "Mentor",
      "description": "Profil mentor akademik MandalikaEdu peraih beasiswa bergengsi",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifier mentor"
        },
        "name": {
          "type": "string",
          "description": "Nama lengkap mentor beserta gelar akademik"
        },
        "role": {
          "type": "string",
          "description": "Peran atau posisi mentoring"
        },
        "origin": {
          "type": "string",
          "description": "Daerah asal mentor di Indonesia"
        },
        "education": {
          "type": "string",
          "description": "Riwayat pendidikan tinggi dan kampus universitas"
        },
        "scholarship": {
          "type": "string",
          "description": "Beasiswa yang pernah diraih oleh mentor"
        },
        "bio": {
          "type": "string",
          "description": "Biografi dan keahlian bimbingan"
        }
      },
      "required": ["id", "name", "education", "scholarship"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Kisah sukses awardee bimbingan MandalikaEdu asal berbagai daerah",
