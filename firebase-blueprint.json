        },
        "targetScholarship": {
          "type": "string",
          "description": "Beasiswa yang ditargetkan"
        },
        "targetCountry": {
          "type": "string",
          "description": "Negara tujuan studi"
        },
        "packageId": {
          "type": "string",
          "description": "ID paket yang dipilih (misal: discovery-free)"
        },
        "preferredDate": {
          "type": "string",
          "description": "Jadwal preferensi konsultasi"
        },
        "notes": {
