    }
  },
  "firestore": {
    "/scholarships/{scholarshipId}": {
      "schema": "Scholarship",
      "description": "Koleksi seluruh 60 database beasiswa Fully Funded untuk WNI dengan rincian jadwal dan syarat"
    },
    "/packages/{packageId}": {
      "schema": "Package",
      "description": "Koleksi paket layanan mentoring bimbingan beasiswa MandalikaEdu"
    },
    "/mentors/{mentorId}": {
      "schema": "Mentor",
      "description": "Koleksi profil tim mentor dan alumni universitas top dunia"
    },
    "/testimonials/{testimonialId}": {
      "schema": "Testimonial",
      "description": "Koleksi kisah sukses dan testimoni awardee asal daerah"
    },
    "/countries/{countryId}": {
      "schema": "Country",
      "description": "Koleksi direktori panduan negara tujuan studi dan regulasi visa mahasiswa"
    },
    "/blogPosts/{postId}": {
      "schema": "BlogPost",
      "description": "Koleksi artikel panduan esai, tips beasiswa, dan wawasan studi luar negeri"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Koleksi pendaftaran sesi Discovery Gratis dan konsultasi berbayar siswa"
    },
    "/leadMagnets/{leadId}": {
      "schema": "LeadMagnet",
      "description": "Koleksi data pendaftar e-book panduan beasiswa dan ceklis persiapan"
    }
  }
}
